{
  "manifest_version": 3,
  "name": "Keyboard Practice",
  "version": "0.1.0",
  "description": "A private, local keyboard practice session.",
  "action": {
    "default_title": "Open keyboard practice"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
